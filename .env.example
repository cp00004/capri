# Chat + transcription: https://console.groq.com/keys
GROQ_API_KEY=
CAPRI_MODEL=openai/gpt-oss-120b
CAPRI_CHAT_PROVIDER=groq
PORT=4173

# Neural voice: https://aistudio.google.com/apikey
# Gemini keys start with AQ. Groq keys start with gsk_. They are not interchangeable.
GEMINI_API_KEY=
CAPRI_GEMINI_MODEL=gemini-3.5-flash
CAPRI_TTS_MODEL=gemini-3.8-flash-tts

# Sign in with Google. Create a Web OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized JS origins: https://cp00004.github.io, https://capricorn.de.deplexo.com,
# https://deplexo.com, http://localhost:4173, https://localhost:4174
# Authorized redirect URIs: leave empty (GIS uses popup, no redirect needed)
GOOGLE_CLIENT_ID=240583618801-6l8bpgneim3nfker6kbbbj4brt2gjrg2.apps.googleusercontent.com

# Commit and push tracked updates to GitHub automatically.
CAPRI_AUTOPUBLISH=1

# Optional: your own cloned voice. Create the voice in ElevenLabs, paste both ids.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Six-digit code a phone types to pair. Random every boot when unset.
# CAPRI_PAIR_CODE=123456

# Set to off to boot with her hands tied: no shell, no files, no apps.
# CAPRI_PC=off

# Phone HTTPS port. Defaults to PORT + 1 when cert.pem / key.pem exist.
# CAPRI_HTTPS_PORT=4174

# Comma-separated origins allowed to call the API from a hosted UI.
# Not needed when the phone loads the app straight from this PC.
# CAPRI_ALLOW_ORIGINS=https://your-app.example
