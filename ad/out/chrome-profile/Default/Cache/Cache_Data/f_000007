<script>
(() => {
  "use strict";
  const $ = (id) => document.getElementById(id);
  const clamp01 = (v) => Math.max(0, Math.min(1, v));
  const ramp = (t, a, b) => clamp01((t - a) / (b - a));
  const easeOut = (x) => 1 - Math.pow(1 - x, 3);
  const easeInOut = (x) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);
  const hash = (n) => {
    let x = Math.imul(n ^ 0x9e3779b9, 0x85ebca6b);
    x ^= x >>> 13;
    x = Math.imul(x, 0xc2b2ae35);
    x ^= x >>> 16;
    return (x >>> 0) / 4294967296;
  };
  const noise1 = (t, seed) => hash(Math.floor(t * 24) * 7919 + seed);

  const W = 1920, H = 1080;
  const SCENES = [
    { id: "s1", a: 0.0,  b: 3.2  },
    { id: "s2", a: 3.2,  b: 7.8  },
    { id: "s3", a: 7.8,  b: 13.0 },
    { id: "s4", a: 13.0, b: 17.8 },
    { id: "s5", a: 17.8, b: 22.6 },
    { id: "s6", a: 22.6, b: 26.6 },
    { id: "s7", a: 26.6, b: 30.0 },
  ];
  const DURATION = 30;

  /* ---------------------------------------------------------- typography */
  const text = {
    tag: "a voice-first cyberpunk for pc + android.",
    s2a: "capri, open youtube.",
    s2b: "opening it. lofi incoming.",
    s3a: "you've been on this tab for 42 minutes.",
    s3b: "i'm not judging. i'm narrating.",
  };

  function typeInto(el, str, t, start, cps, keepCaret) {
    if (t < start) { el.textContent = ""; return; }
    const n = Math.min(str.length, Math.floor((t - start) * cps));
    const caret = keepCaret && n < str.length ? "▌" : "";
    el.textContent = str.slice(0, n) + caret;
  }
  function reveal(el, t, start, dur = 0.55, dy = 26) {
    const p = easeOut(ramp(t, start, start + dur));
    el.style.opacity = String(p);
    el.style.transform = `translateY(${((1 - p) * dy).toFixed(2)}px)`;
  }
  function pop(el, t, start, dur = 0.4) {
    const p = easeOut(ramp(t, start, start + dur));
    el.style.opacity = String(p);
    el.style.transform = `translateY(${((1 - p) * 16).toFixed(1)}px) scale(${(0.94 + p * 0.06).toFixed(3)})`;
  }

  /* -------------------------------------------------------------- backdrop */
  const bg = $("bg");
  const bctx = bg.getContext("2d");
  const bgGlowA = bctx.createRadialGradient(1560, -120, 40, 1560, -120, 900);
  bgGlowA.addColorStop(0, "rgba(77,255,157,.12)");
  bgGlowA.addColorStop(1, "rgba(77,255,157,0)");
  const bgGlowB = bctx.createRadialGradient(120, 1180, 60, 120, 1180, 1000);
  bgGlowB.addColorStop(0, "rgba(255,79,216,.12)");
  bgGlowB.addColorStop(1, "rgba(255,79,216,0)");

  function drawBg(t) {
    bctx.fillStyle = "#07000c";
    bctx.fillRect(0, 0, W, H);

    bctx.globalAlpha = 0.7 + 0.3 * Math.sin(t * 0.7);
    bctx.fillStyle = bgGlowA;
    bctx.fillRect(0, 0, W, H);
    bctx.fillStyle = bgGlowB;
    bctx.fillRect(0, 0, W, H);
    bctx.globalAlpha = 1;

    bctx.strokeStyle = "rgba(120,180,255,.055)";
    bctx.lineWidth = 1;
    bctx.beginPath();
    const drift = (t * 9) % 96;
    for (let x = -96 + drift; x < W + 96; x += 96) { bctx.moveTo(x + 0.5, 0); bctx.lineTo(x + 0.5, H); }
    for (let y = 0; y < H; y += 96) { bctx.moveTo(0, y + 0.5); bctx.lineTo(W, y + 0.5); }
    bctx.stroke();

    // occasional chromatic tear across the frame
    for (let i = 0; i < 3; i++) {
      const r = noise1(t, 101 + i);
      if (r < 0.86) continue;
      const y = Math.floor(noise1(t, 201 + i) * H);
      const h = 2 + Math.floor(noise1(t, 301 + i) * 26);
      bctx.fillStyle = i === 0 ? "rgba(255,79,216,.09)" : i === 1 ? "rgba(43,107,255,.09)" : "rgba(77,255,157,.07)";
      bctx.fillRect(0, y, W, h);
    }
  }

  // One noise tile, reused with per-frame offsets.
  (() => {
    const c = document.createElement("canvas");
    c.width = 256; c.height = 256;
    const x = c.getContext("2d");
    const img = x.createImageData(256, 256);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = Math.floor(hash(i * 2654435761) * 255);
      img.data[i] = img.data[i + 1] = img.data[i + 2] = v;
      img.data[i + 3] = 42;
    }
    x.putImageData(img, 0, 0);
    $("noise").style.backgroundImage = `url(${c.toDataURL()})`;
  })();

  /* ------------------------------------------------------------------- hud */
  const hudScene = $("hudScene");
  const hudTc = $("hudTc");
  function pad(n, w = 2) { return String(n).padStart(w, "0"); }
  function drawHud(t) {
    let idx = 1;
    for (let i = 0; i < SCENES.length; i++) if (t >= SCENES[i].a) idx = i + 1;
    hudScene.textContent = `${pad(idx)} / 07`;
    hudTc.textContent = `00:${pad(Math.floor(t))}:${pad(Math.floor((t % 1) * 30))}`;
    const n = $("noise");
    const ox = Math.floor(noise1(t, 7) * 64);
    const oy = Math.floor(noise1(t, 11) * 64);
    n.style.transform = `translate(${ox}px, ${oy}px)`;
  }

  /* ---------------------------------------------------------------- scene 1 */
  const s1 = {
    el: $("s1"),
    letters: [...$("s1word").children],
    portrait: $("s1portrait"),
    rule: $("s1rule"),
    pc: $("s1pc"),
    tag: $("s1tag"),
    stamp: $("s1stamp"),
  };
  const GLITCHES = [[0.55, 0.66], [1.72, 1.84], [2.86, 3.0]];

  function s1Draw(t) {
    const gl = GLITCHES.some(([a, b]) => t >= a && t <= b) ? 1 : 0;
    const jit = gl ? (noise1(t, 3) - 0.5) * 18 : 0;
    s1.letters.forEach((el, i) => {
      const p = easeOut(ramp(t, 0.12 + i * 0.075, 0.52 + i * 0.075));
      el.style.opacity = String(p);
      el.style.transform = `translateY(${((1 - p) * 40).toFixed(1)}px)`;
    });
    const word = $("s1word");
    word.style.transform = `translateX(${jit.toFixed(1)}px)`;
    word.style.textShadow = gl
      ? `${8 + jit}px 0 rgba(255,79,216,.75), ${-8 + jit}px 0 rgba(43,107,255,.75), 0 0 70px rgba(77,255,157,.2)`
      : "4px 0 rgba(255,79,216,.45), -4px 0 rgba(43,107,255,.45), 0 0 70px rgba(77,255,157,.18)";

    const pr = easeInOut(ramp(t, 0.0, 1.5));
    s1.portrait.style.opacity = String(0.16 + pr * 0.5);
    s1.portrait.style.transform = `scale(${(1.08 - pr * 0.08).toFixed(3)}) translateY(${((1 - pr) * 26).toFixed(1)}px)`;

    const rp = easeOut(ramp(t, 0.9, 1.7));
    s1.rule.style.width = `${(132 * rp).toFixed(1)}px`;
    s1.rule.style.opacity = String(rp);
    reveal(s1.pc, t, 1.0, 0.6, 16);
    typeInto(s1.tag, text.tag, t, 1.45, 30, true);
    s1.tag.style.opacity = t >= 1.45 ? "1" : "0";
    reveal(s1.stamp, t, 2.1, 0.6, 14);
  }

  /* ---------------------------------------------------------------- scene 2 */
  const s2 = {
    label: $("s2label"), l1: $("s2l1"), l2: $("s2l2"), chips: $("s2chips"),
    r1: $("s2r1"), r2: $("s2r2"), r3: $("s2r3"),
    wave: $("s2wave"), cap: $("s2cap"),
    bu: $("s2bu"), but: $("s2but"), bc: $("s2bc"), bct: $("s2bct"),
  };
  const s2Bars = [];
  for (let i = 0; i < 44; i++) { const b = document.createElement("i"); s2.wave.appendChild(b); s2Bars.push(b); }

  function s2Draw(t) {
    reveal(s2.label, t, 0.05, 0.5, 14);
    reveal(s2.l1, t, 0.18, 0.6, 30);
    reveal(s2.l2, t, 0.62, 0.6, 30);
    reveal(s2.chips, t, 1.05, 0.6, 18);

    s2.r1.style.transform = `rotate(${(t * 26).toFixed(1)}deg)`;
    s2.r2.style.transform = `rotate(${(-t * 18).toFixed(1)}deg)`;
    s2.r3.style.transform = `rotate(${(t * 40).toFixed(1)}deg)`;

    const speaking = t > 1.15 && t < 3.0;
    const energy = speaking ? 0.55 + 0.45 * Math.sin(t * 7.5) : 0.18;
    s2Bars.forEach((b, i) => {
      const env = Math.sin(Math.PI * (i / (s2Bars.length - 1)));
      const wob = 0.35 + 0.65 * Math.abs(Math.sin(t * 6.2 + i * 0.52) * Math.cos(t * 2.7 + i * 0.21));
      const h = 5 + env * wob * (18 + energy * 78);
      b.style.height = `${h.toFixed(1)}px`;
      b.style.opacity = String(0.35 + env * 0.65);
    });
    s2.cap.textContent = t < 1.2 ? "LISTENING" : t < 3.05 ? "HEARING YOU" : "ANSWERED";

    pop(s2.bu, t, 1.28, 0.35);
    typeInto(s2.but, text.s2a, t, 1.4, 26, true);
    pop(s2.bc, t, 2.55, 0.35);
    typeInto(s2.bct, text.s2b, t, 2.7, 30, true);
  }

  /* ---------------------------------------------------------------- scene 3 */
  const eyeCanvas = $("eyeCanvas");
  const ectx = eyeCanvas.getContext("2d");
  const EW = 1128, EH = 751;
  const eye = { ready: false, cut: null, cx: 0, cy: 0, r: 0 };

  function buildEye(img) {
    const scale = Math.min(1, 1536 / img.naturalWidth);
    const w = Math.max(1, Math.round(img.naturalWidth * scale));
    const h = Math.max(1, Math.round(img.naturalHeight * scale));
    const work = document.createElement("canvas");
    work.width = w; work.height = h;
    const c = work.getContext("2d");
    c.drawImage(img, 0, 0, w, h);
    const frame = c.getImageData(0, 0, w, h);
    const px = frame.data;
    for (let i = 0; i < px.length; i += 4) {
      const low = Math.min(px[i], px[i + 1], px[i + 2]);
      const k = Math.min(1, Math.max(0, (low - 150) / 45));
      if (k > 0) px[i + 3] = Math.round(px[i + 3] * (1 - k));
    }
    c.putImageData(frame, 0, 0);
    let x0 = w, y0 = h, x1 = -1, y1 = -1;
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        if (px[(y * w + x) * 4 + 3] > 12) {
          if (x < x0) x0 = x; if (x > x1) x1 = x;
          if (y < y0) y0 = y; if (y > y1) y1 = y;
        }
      }
    }
    const pad = 4;
    x0 = Math.max(0, x0 - pad); y0 = Math.max(0, y0 - pad);
    x1 = Math.min(w - 1, x1 + pad); y1 = Math.min(h - 1, y1 + pad);
    const cut = document.createElement("canvas");
    cut.width = x1 - x0 + 1;
    cut.height = y1 - y0 + 1;
    cut.getContext("2d").drawImage(work, x0, y0, cut.width, cut.height, 0, 0, cut.width, cut.height);
    eye.cut = cut;

    // The iris is the only strongly blue mass in the art. Lashes also catch a
    // little blue, so measure the largest connected blue blob rather than every
    // bluish pixel; that puts the socket exactly on the printed pupil.
    const cd = cut.getContext("2d").getImageData(0, 0, cut.width, cut.height).data;
    const bw = cut.width, bh = cut.height;
    const isBlue = (i) => cd[i + 2] > 150 && cd[i + 2] - cd[i] > 70 && cd[i + 2] - cd[i + 1] > 30;
    const seen = new Uint8Array(bw * bh);
    let best = null;
    for (let y0 = 0; y0 < bh; y0++) {
      for (let x0 = 0; x0 < bw; x0++) {
        const start = y0 * bw + x0;
        if (seen[start] || !isBlue(start * 4)) continue;
        const stack = [start];
        seen[start] = 1;
        const pts = [];
        while (stack.length) {
          const p = stack.pop();
          pts.push(p);
          const px = p % bw, py = (p - px) / bw;
          const around = [
            px > 0 ? p - 1 : -1,
            px < bw - 1 ? p + 1 : -1,
            py > 0 ? p - bw : -1,
            py < bh - 1 ? p + bw : -1,
          ];
          for (const q of around) {
            if (q < 0 || seen[q] || !isBlue(q * 4)) continue;
            seen[q] = 1;
            stack.push(q);
          }
        }
        if (!best || pts.length > best.length) best = pts;
      }
    }
    if (best && best.length > 400) {
      let sx = 0, sy = 0;
      for (const p of best) { sx += p % bw; sy += (p - (p % bw)) / bw; }
      eye.cxRaw = sx / best.length;
      eye.cyRaw = sy / best.length;
      const dists = best.map((p) => Math.hypot((p % bw) - eye.cxRaw, (p - (p % bw)) / bw - eye.cyRaw));
      dists.sort((a, b) => a - b);
      eye.rRaw = dists[Math.floor(dists.length * 0.98)] || 100;
    } else {
      eye.cxRaw = 0.4817 * cut.width;
      eye.cyRaw = 0.621 * cut.height;
      eye.rRaw = 0.0978 * cut.width;
    }
    eye.ready = true;
    layoutEye();
  }

  function layoutEye() {
    const cut = eye.cut;
    if (!cut) return;
    eye.scale = Math.min(EW / cut.width, EH / cut.height) * 0.94;
    eye.dw = cut.width * eye.scale;
    eye.dh = cut.height * eye.scale;
    eye.ox = (EW - eye.dw) / 2;
    eye.oy = (EH - eye.dh) / 2;
    eye.cx = eye.ox + eye.cxRaw * eye.scale;
    eye.cy = eye.oy + eye.cyRaw * eye.scale;
    eye.r = eye.rRaw * eye.scale;
  }

  // Draws her cut art, covers the printed iris with a shadowed socket, then
  // slides a disc cut from the same art inside it: the glance reads as a pupil
  // travelling, not as the whole face shifting.
  function drawEye(t) {
    if (!eye.ready) return;
    ectx.clearRect(0, 0, EW, EH);
    ectx.drawImage(eye.cut, eye.ox, eye.oy, eye.dw, eye.dh);

    const amp = eye.r * 0.28;
    const gx = (Math.sin(t * 1.55) * 0.85 + Math.sin(t * 0.53 + 1.2) * 0.45) * amp;
    const gy = (Math.cos(t * 1.13 + 0.4) * 0.7 + Math.sin(t * 0.71) * 0.3) * amp;

    const cx = eye.cx, cy = eye.cy;
    const r = eye.r;

    // socket: the recess the iris sits in, so the printed one is never visible
    const socket = ectx.createRadialGradient(cx, cy, r * 0.05, cx, cy, r);
    socket.addColorStop(0, "rgba(10,0,12,.98)");
    socket.addColorStop(0.82, "rgba(8,0,10,.97)");
    socket.addColorStop(0.94, "rgba(6,0,10,.8)");
    socket.addColorStop(1, "rgba(6,0,10,0)");
    ectx.fillStyle = socket;
    ectx.beginPath();
    ectx.arc(cx, cy, r, 0, Math.PI * 2);
    ectx.fill();

    ectx.save();
    ectx.beginPath();
    ectx.arc(cx, cy, r * 0.94, 0, Math.PI * 2);
    ectx.clip();
    ectx.drawImage(eye.cut, eye.ox + gx, eye.oy + gy, eye.dw, eye.dh);
    // soft inner rim so the disc reads as recessed
    const rim = ectx.createRadialGradient(cx, cy, r * 0.5, cx, cy, r * 0.96);
    rim.addColorStop(0, "rgba(0,0,0,0)");
    rim.addColorStop(1, "rgba(3,0,8,.5)");
    ectx.fillStyle = rim;
    ectx.fillRect(cx - r, cy - r, r * 2, r * 2);
    // scanning band
    const sy = cy - r + ((t * 120) % (r * 2));
    const band = ectx.createLinearGradient(0, sy - 14, 0, sy + 14);
    band.addColorStop(0, "rgba(77,255,157,0)");
    band.addColorStop(0.5, "rgba(77,255,157,.25)");
    band.addColorStop(1, "rgba(77,255,157,0)");
    ectx.fillStyle = band;
    ectx.fillRect(cx - r, sy - 14, r * 2, 28);
    ectx.restore();

    // fixed catchlight
    const g = r * 0.4;
    const gl = ectx.createRadialGradient(cx - r * 0.3, cy - r * 0.34, 1, cx - r * 0.3, cy - r * 0.34, g);
    gl.addColorStop(0, "rgba(255,255,255,.85)");
    gl.addColorStop(0.5, "rgba(200,255,232,.28)");
    gl.addColorStop(1, "rgba(200,255,232,0)");
    ectx.fillStyle = gl;
    ectx.beginPath();
    ectx.arc(cx - r * 0.3, cy - r * 0.34, g, 0, Math.PI * 2);
    ectx.fill();
  }

  const s3 = {
    bubble: $("s3bubble"), line: $("s3line"),
    r1: $("s3r1"), r2: $("s3r2"), r3: $("s3r3"),
  };
  function s3Draw(t) {
    drawEye(t);
    pop(s3.bubble, t, 0.55, 0.4);
    if (t < 3.15) typeInto(s3.line, text.s3a, t, 0.7, 34, true);
    else typeInto(s3.line, text.s3b, t, 3.25, 38, true);
    reveal(s3.r1, t, 0.9, 0.5, 18);
    reveal(s3.r2, t, 1.25, 0.5, 18);
    reveal(s3.r3, t, 1.6, 0.5, 18);
  }

  /* ---------------------------------------------------------------- scene 4 */
  const s4 = {
    copy: document.querySelector("#s4 .copy"),
    wrap: $("s4winWrap"), win: $("s4win"),
    m1: $("s4m1"), m2: $("s4m2"), wave: $("s4wave"), mic: $("s4mic"),
    cursor: $("s4cursor"), ring: $("s4ring"),
  };
  const s4Bars = [];
  for (let i = 0; i < 60; i++) { const b = document.createElement("i"); s4.wave.appendChild(b); s4Bars.push(b); }

  function s4Draw(t) {
    reveal(s4.copy, t, 0.1, 0.6, 24);
    const p = easeOut(ramp(t, 0.0, 0.9));
    s4.wrap.style.opacity = String(p);
    s4.wrap.style.transform = `translateY(${((1 - p) * 46).toFixed(1)}px)`;
    // slow push so the mockup feels alive, not pasted
    const turn = -7 + 4.2 * easeInOut(ramp(t, 0, 4.6));
    s4.win.style.transform = `rotateY(${turn.toFixed(2)}deg) rotateX(${(2.4 - 1.2 * p).toFixed(2)}deg) scale(${(0.98 + 0.02 * p).toFixed(3)})`;

    pop(s4.m1, t, 0.55, 0.35);
    pop(s4.m2, t, 1.5, 0.4);

    s4Bars.forEach((b, i) => {
      const env = Math.sin(Math.PI * (i / (s4Bars.length - 1)));
      const speaking = t > 1.6 && t < 2.9;
      const amp = speaking ? 0.55 + 0.45 * Math.abs(Math.sin(t * 7 + i * 0.4)) : 0.14 + 0.1 * Math.abs(Math.sin(t * 2 + i * 0.3));
      b.style.height = `${(4 + env * amp * 54).toFixed(1)}px`;
      b.style.opacity = String(0.3 + env * 0.7);
    });

    // cursor: walks to the mic, clicks, retracts
    const cp = easeInOut(ramp(t, 2.5, 3.6));
    const x = 330 + cp * 620;
    const y = 620 - cp * 430;
    s4.cursor.style.opacity = String(ramp(t, 2.35, 2.6) * (1 - ramp(t, 4.1, 4.5)));
    s4.cursor.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px)`;
    const clickT = 3.65;
    const cp2 = clamp01((t - clickT) / 0.45);
    s4.ring.style.opacity = String(t >= clickT ? (1 - cp2) : 0);
    s4.ring.style.transform = `translate(${(x - 32).toFixed(1)}px, ${(y - 32).toFixed(1)}px) scale(${(0.4 + cp2 * 1.4).toFixed(2)})`;
    const pulse = t > clickT && t < clickT + 0.9 ? 1 + 0.16 * Math.sin((t - clickT) * 18) : 1;
    s4.mic.style.transform = `scale(${pulse.toFixed(3)})`;
    s4.mic.style.boxShadow = t > clickT ? `0 0 ${(24 * (1 - cp2) + 6).toFixed(0)}px rgba(77,255,157,.85)` : "none";
  }

  /* ---------------------------------------------------------------- scene 5 */
  const s5 = {
    copy: document.querySelector("#s5 .copy"),
    phone: $("s5phone"), notif: $("s5notif"),
    m1: $("s5m1"), m2: $("s5m2"), wave: $("s5wave"),
  };
  const s5Bars = [];
  for (let i = 0; i < 34; i++) { const b = document.createElement("i"); s5.wave.appendChild(b); s5Bars.push(b); }

  function s5Draw(t) {
    reveal(s5.copy, t, 0.1, 0.6, 24);
    const p = easeOut(ramp(t, 0.0, 0.85));
    s5.phone.style.opacity = String(p);
    s5.phone.style.transform = `translateY(${((1 - p) * 70).toFixed(1)}px) rotate(${(2.6 - 2.6 * p).toFixed(2)}deg)`;
    pop(s5.m1, t, 0.5, 0.35);
    pop(s5.m2, t, 1.35, 0.4);
    s5Bars.forEach((b, i) => {
      const env = Math.sin(Math.PI * (i / (s5Bars.length - 1)));
      const amp = t > 0.6 && t < 2.2 ? 0.5 + 0.5 * Math.abs(Math.sin(t * 7.5 + i * 0.45)) : 0.16 + 0.1 * Math.abs(Math.sin(t * 2.2 + i * 0.3));
      b.style.height = `${(3 + env * amp * 40).toFixed(1)}px`;
      b.style.opacity = String(0.3 + env * 0.7);
    });
    const np = easeOut(ramp(t, 1.95, 2.35));
    s5.notif.style.opacity = String(np);
    s5.notif.style.transform = `translateY(${((1 - np) * -34).toFixed(1)}px)`;
  }

  /* ---------------------------------------------------------------- scene 6 */
  const s6 = {
    date: $("s6date"), l1: $("s6l1"), l2: $("s6l2"),
    c1: $("s6c1"), c2: $("s6c2"), c3: $("s6c3"),
    cal: $("s6cal"), count: $("s6count"),
  };
  (() => {
    for (let i = 1; i <= 30; i++) {
      const d = document.createElement("div");
      d.className = "cell";
      d.textContent = String(i).padStart(2, "0");
      if (i === 1) d.classList.add("today");
      s6.cal.appendChild(d);
    }
  })();

  function s6Draw(t) {
    reveal(s6.date, t, 0.05, 0.5, 18);
    reveal(s6.l1, t, 0.2, 0.55, 26);
    reveal(s6.l2, t, 0.42, 0.55, 26);
    reveal(s6.c1, t, 0.85, 0.5, 18);
    reveal(s6.c2, t, 1.05, 0.5, 18);
    reveal(s6.c3, t, 1.25, 0.5, 18);
  }

  /* ---------------------------------------------------------------- scene 7 */
  const s7 = { mk: $("s7mk"), get: $("s7get"), d1: $("s7d1"), d2: $("s7d2"), url: $("s7url"), foot: $("s7foot") };
  const mkCtx = $("mkCanvas").getContext("2d");
  function drawMark() {
    if (!eye.cut) return;
    const cw = 940, ch = 628;
    const k = Math.min(cw / eye.cut.width, ch / eye.cut.height) * 0.98;
    const w = eye.cut.width * k, h = eye.cut.height * k;
    mkCtx.clearRect(0, 0, cw, ch);
    mkCtx.drawImage(eye.cut, (cw - w) / 2, (ch - h) / 2, w, h);
  }
  function s7Draw(t) {
    drawMark();
    const p = easeOut(ramp(t, 0.05, 0.7));
    s7.mk.style.opacity = String(p);
    s7.mk.style.transform = `scale(${(0.9 + p * 0.1).toFixed(3)})`;
    reveal(s7.get, t, 0.25, 0.6, 28);
    reveal(s7.d1, t, 0.75, 0.5, 20);
    reveal(s7.d2, t, 0.9, 0.5, 20);
    reveal(s7.url, t, 1.25, 0.5, 16);
    reveal(s7.foot, t, 1.45, 0.5, 12);
  }

  /* ------------------------------------------------------------------ seek */
  const drawFns = { s1: s1Draw, s2: s2Draw, s3: s3Draw, s4: s4Draw, s5: s5Draw, s6: s6Draw, s7: s7Draw };
  window.seek = (t) => {
    t = Math.max(0, Math.min(DURATION - 1e-4, Number(t) || 0));
    drawBg(t);
    drawHud(t);
    for (const sc of SCENES) {
      const el = $(sc.id);
      const op = Math.min(ramp(t, sc.a, sc.a + 0.34), 1 - ramp(t, sc.b - 0.26, sc.b));
      el.style.opacity = op.toFixed(3);
      el.style.visibility = op > 0.002 ? "visible" : "hidden";
      if (op > 0.002) drawFns[sc.id](t - sc.a);
    }
    return true;
  };

  window.AD_READY = false;
  const img = new Image();
  img.onload = () => { buildEye(img); window.AD_READY = true; window.seek(0); };
  img.onerror = () => { window.AD_READY = "no-eye-art"; window.seek(0); };
  img.src = "/public/assets/eye-spy.png";
})();
</script>
</body>
</html>
