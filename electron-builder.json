{
  "appId": "com.capricorn.capri",
  "productName": "Capri",
  "artifactName": "Capri-v4-Setup.${ext}",
  "copyright": "Project Capricorn",
  "asar": false,
  "electronDist": "electron-dist-clean",
  "files": [
    "electron/**/*",
    "public/**/*",
    "lib/**/*",
    "server.js",
    "agent.js",
    "package.json",
    "!public/assets/*.apk",
    "!**/.git/**",
    "!dist-electron/**"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "public/assets/icon-512.png",
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": true,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Capri",
    "include": "electron/installer.nsh"
  },
  "directories": {
    "output": "dist-electron"
  }
}
